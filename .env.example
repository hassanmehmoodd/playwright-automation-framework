# Copy to .env for local overrides. Process environment wins over .env,
# and .env wins over config/environments/<TEST_ENV>.env.
# Values below are the public demo credentials published by each target app.

# local | ci  (selects config/environments/<TEST_ENV>.env)
TEST_ENV=local

# SauceDemo UI (https://www.saucedemo.com)
BASE_URL=https://www.saucedemo.com
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# DummyJSON API (https://dummyjson.com)
API_BASE_URL=https://dummyjson.com
API_USERNAME=emilys
API_PASSWORD=emilyspass

# Set to true to print HTTP status lines from the API client.
DEBUG_TESTS=false
